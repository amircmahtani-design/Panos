/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Facebook, WhatsApp and Viber cache the share card hard. A shorter life here
# means a replacement picture shows up in previews within a day, not never.
/og-image.jpg
  Cache-Control: public, max-age=86400

# Revalidate on every visit. Netlify sends an ETag, so an unchanged file is a
# tiny 304 and costs nothing — but a changed one is picked up immediately
# instead of a week later. The ?v= on the tags is the second line of defence.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/content.json
  Cache-Control: public, max-age=0, must-revalidate

/studio/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
